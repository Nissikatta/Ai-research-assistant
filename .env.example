# Application
APP_NAME=AI Research & Knowledge Assistant
DEBUG=True

# Database
DATABASE_URL=sqlite:///./app.db

# Upload Directory
UPLOAD_DIR=uploads

# FAISS Index
FAISS_INDEX_PATH=data/faiss_index

# Embedding Model
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# LLM (Optional)
OLLAMA_MODEL=llama3

# API Settings
HOST=127.0.0.1
PORT=8000